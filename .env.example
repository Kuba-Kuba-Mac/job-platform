# Скопируйте в .env: cp .env.example .env
# Файл .env НЕ коммитится (он в .gitignore)

# Длинная случайная строка (не короче 32 символов, иначе PyJWT предупреждает). Сгенерировать: make secret
DJANGO_SECRET_KEY=change-me-dev-only-insecure-key-generate-with-make-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=jobplatform
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=jobplatform
POSTGRES_PORT=5432

# Почта (F-04). В Docker письма ловит Mailpit: http://localhost:8025
# Без EMAIL_HOST письма печатаются в консоль backend.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Стажировки KG <noreply@stazhirovki.kg>
# Адрес frontend — на него ведут ссылки в письмах
FRONTEND_URL=http://localhost:5173

# Вымышленные демо-данные при старте контейнера (make reseed — пересоздать)
SEED_DEMO=true
